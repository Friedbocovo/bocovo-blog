# URL de base de l'API Laravel déployée sur Railway
# Pour le développement local : http://localhost:8080/api  
# Pour la production : https://YOUR-RAILWAY-DOMAIN.up.railway.app/api
VITE_API_URL=http://localhost:8080/api

# Configuration WebSocket Reverb
VITE_REVERB_APP_KEY=local
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Pour la production sur Vercel, utilisez :
# VITE_API_URL=https://blog-api-production-5c17.up.railway.app/api
# VITE_REVERB_HOST=blog-api-production-5c17.up.railway.app
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https